{
	"schemaVersion": 1,
	"id": "biobook",
	"version": "${version}",
	"name": "Bio Book",
	"description": "Clickable chat portraits, character lore, and personal journal notes.",
	"authors": [
		"Icy"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/biobook/logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.biobook.BioBook"
		],
		"client": [
			"dev.biobook.client.BioClient"
		]
	},
	"mixins": [
		{
			"config": "biobook.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
